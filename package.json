{
  "name": "understudy",
  "version": "0.1.0",
  "private": true,
  "description": "Publish now-playing activity from self-hosted services as Discord presence via headless sessions",
  "homepage": "https://github.com/the-snesler/understudy",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "pnpm build:ui && tsx watch src/index.ts",
    "build": "pnpm build:ui && tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev:css": "tailwindcss -i src/web/styles.css -o assets/app.css --watch",
    "build:css": "tailwindcss -i src/web/styles.css -o assets/app.css --minify",
    "build:ui": "pnpm build:css && node scripts/build-ui.mjs"
  },
  "dependencies": {
    "@fontsource/geist": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@hono/node-server": "^2.1.3",
    "hono": "^4.13.13",
    "htmx.org": "^2.0.11",
    "ical.js": "^2.2.1",
    "lucide": "^1.54.0",
    "nxapi": "1.6.1-next.257",
    "simple-icons": "^16.34.0",
    "sortablejs": "^1.15.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^22.20.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@11.3.0"
}
