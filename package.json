{
  "name": "server-rpc",
  "version": "0.1.0",
  "private": true,
  "description": "Publish now-playing activity from self-hosted services as Discord presence via headless sessions",
  "homepage": "https://samnesler.com",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "hono": "^4.13.13",
    "htmx.org": "^2.0.11",
    "nxapi": "1.6.1-next.257",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@11.3.0"
}
